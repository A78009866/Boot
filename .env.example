# ===== إعدادات إلزامية =====
# 1) توكن البوت من @BotFather (لا تشاركه مع أحد)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) معرّف محادثتك في تلغرام (هو نفسه معرّف حسابك عند المراسلة الخاصة)
TELEGRAM_CHAT_ID=6519532861

# ===== إعدادات اختيارية =====
# الدومين النهائي (اختياري: يُستنتج تلقائيًا من الطلب على Vercel)
# يُستخدم في وسوم معاينة الرابط og:image / og:video
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# رمز دخول بسيط تحميه للصفحة (إذا تركته فارغًا تصبح الصفحة مفتوحة لأي شخص)
# ACCESS_CODE=my-secret-123

# المنطقة الزمنية المستخدمة في نص الرسالة
# CAPTION_TIMEZONE=Africa/Algiers

# مسار مخصص لملف ffmpeg (اختياري — يُستخدم فقط لتحويل WebM إلى MP4)
# FFMPEG_PATH=/usr/bin/ffmpeg
